# Sprintline backend configuration.
# Every value is optional: the service boots on a bare clone with no .env file.
# install.sh writes a random JWT_SECRET here on first run.

# Relative SQLite file created and seeded automatically on boot.
SPRINTLINE_DATABASE_URL=sqlite:///./app.db

# Any long random string. Left unset the in-code development fallback is used.
# Generate one with: openssl rand -hex 32
# JWT_SECRET=

# Session lifetime in minutes (12 hours).
JWT_EXPIRE_MINUTES=720

# Comma separated origins, or * for the dev proxy setup.
CORS_ORIGINS=*

# Seed the demo workspace automatically when the database is empty.
AUTO_SEED=true
